# ==============================================================================
# ERIS-NEXA ELEVATORS — PERFORMANCE & CACHE REVALIDATION CONFIGURATION (.htaccess)
# Designed for Apache & LiteSpeed Web Server (Hostinger)
# ==============================================================================

# 1. Disable Directory Listing
Options -Indexes

# 2. Character Encoding
AddDefaultCharset UTF-8

# 3. Proper MIME Types
<IfModule mod_mime.c>
  AddType text/html .html .htm
  AddType text/css .css
  AddType application/javascript .js
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
</IfModule>

# 4. Cache-Control Headers (Force Fresh Version on Mobile & Desktop)
<IfModule mod_headers.c>
  # HTML Documents: STRICT NO-CACHE
  # Ensures clients and mobile browsers always fetch the newest HTML markup & versioned links
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Stylesheets & JavaScript: Instant Revalidation
  # When versions change, browser updates immediately without stale cache lock
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Media & Fonts: Cache with revalidation
  <FilesMatch "\.(mp4|webm|jpg|jpeg|png|webp|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # Prevent 304 conditional cache persistence on stale code
  Header unset ETag
</IfModule>

FileETag None

# 5. Gzip / Deflate Compression for Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
